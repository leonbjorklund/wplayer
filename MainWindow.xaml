<Window x:Class="WPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPlayer"
        Icon="logo.ico"
        MinWidth="220"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.ContextMenu>
        <ContextMenu x:Name="PlayerContextMenu"
                     Background="#2B2B2B"
                     BorderBrush="#545454"
                     BorderThickness="1"
                     Padding="2"
                     SnapsToDevicePixels="True"
                     UseLayoutRounding="True">
            <ContextMenu.Template>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Foreground" Value="#F1F3F4" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="MinWidth" Value="90" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type MenuItem}">
                                <Border x:Name="ItemBorder"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="CheckMark"
                                              Width="9"
                                              Height="7"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Data="M1,3.5 L3.5,6 L8,1"
                                              Visibility="Collapsed" />
                                        <ContentPresenter Grid.Column="1"
                                                          ContentSource="Header"
                                                          RecognizesAccessKey="True"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#3D3D3D" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
                       TargetType="{x:Type Separator}">
                    <Setter Property="OverridesDefaultStyle" Value="True" />
                    <Setter Property="Margin" Value="-2,3" />
                    <Setter Property="Background" Value="#545454" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Separator}">
                                <Border Background="{TemplateBinding Background}"
                                        SnapsToDevicePixels="True" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="Settings" Click="Settings_Click" />
            <Separator />
            <MenuItem x:Name="DragToMoveMenuItem"
                      Header="Draggable"
                      IsCheckable="True"
                      Click="DragToMove_Click" />
            <Separator />
            <MenuItem Header="Exit" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <SolidColorBrush x:Key="PlaybackButtonHoverBackgroundBrush" Color="#565656" />
        <SolidColorBrush x:Key="UtilityHoverBackgroundBrush" Color="#2C2C2C" />
        <Style x:Key="KeyboardFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border BorderBrush="{TemplateBinding Foreground}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource PlayerControlCornerRadius}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding Foreground}"
                                CornerRadius="{DynamicResource PlayerControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource PlaybackButtonHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="PlayerSurface" VerticalAlignment="Bottom">
        <Border x:Name="RootBorder"
                HorizontalAlignment="Left">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ControlPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PreviousButton" MinWidth="0" MinHeight="0" AutomationProperties.Name="Previous track" Click="Previous_Click">
                    <Path x:Name="PreviousIcon" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12.7 1a.7.7 0 0 0-.7.7v5.15L2.05 1.107A.7.7 0 0 0 1 1.712v12.575a.7.7 0 0 0 1.05.607L12 9.149V14.3a.7.7 0 0 0 .7.7h1.6a.7.7 0 0 0 .7-.7V1.7a.7.7 0 0 0-.7-.7z">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Path.RenderTransform>
                    </Path>
                </Button>
                <Button x:Name="PlayPauseButton" MinWidth="0" MinHeight="0" AutomationProperties.Name="Play or pause" Click="PlayPause_Click">
                    <Grid x:Name="PlayPauseIconContainer">
                        <Path x:Name="PlayIcon" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M3 1.713a.7.7 0 0 1 1.05-.607l10.89 6.288a.7.7 0 0 1 0 1.212L4.05 14.894A.7.7 0 0 1 3 14.288z" />
                        <Path x:Name="PauseIcon" Stretch="Uniform" Visibility="Collapsed" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M2.7 1a.7.7 0 0 0-.7.7v12.6a.7.7 0 0 0 .7.7h2.6a.7.7 0 0 0 .7-.7V1.7a.7.7 0 0 0-.7-.7zm8 0a.7.7 0 0 0-.7.7v12.6a.7.7 0 0 0 .7.7h2.6a.7.7 0 0 0 .7-.7V1.7a.7.7 0 0 0-.7-.7z" />
                    </Grid>
                </Button>
                <Button x:Name="NextButton" MinWidth="0" MinHeight="0" AutomationProperties.Name="Next track" Click="Next_Click">
                    <Path x:Name="NextIcon" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12.7 1a.7.7 0 0 0-.7.7v5.15L2.05 1.107A.7.7 0 0 0 1 1.712v12.575a.7.7 0 0 0 1.05.607L12 9.149V14.3a.7.7 0 0 0 .7.7h1.6a.7.7 0 0 0-.7-.7V1.7a.7.7 0 0 0-.7-.7z" />
                </Button>
            </StackPanel>

            <Button x:Name="NowPlayingHitTarget"
                    Grid.Column="1"
                    IsTabStop="False"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    FocusVisualStyle="{StaticResource KeyboardFocusVisual}"
                    AutomationProperties.Name="Focus media source"
                    AutomationProperties.HelpText="Scroll to change volume"
                    Click="NowPlayingHitTarget_Click"
                    MouseEnter="NowPlayingHitTarget_MouseEnter"
                    MouseLeave="NowPlayingHitTarget_MouseLeave"
                    MouseWheel="NowPlayingHitTarget_MouseWheel">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NowPlayingBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource PlayerControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsTabStop" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NowPlayingBackground" Property="Background" Value="{DynamicResource UtilityHoverBackgroundBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid x:Name="NowPlayingContent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NowPlayingText"
                               VerticalAlignment="Center"
                               LineStackingStrategy="BlockLineHeight"
                               Text="Nothing playing"
                               TextTrimming="CharacterEllipsis" />
                    <Grid x:Name="VolumeIndicator"
                           Grid.Column="1"
                           Background="Transparent"
                           Visibility="Collapsed"
                           AutomationProperties.Name="Volume"
                           MouseEnter="VolumeIndicator_MouseEnter"
                           MouseLeave="VolumeIndicator_MouseLeave">
                        <Viewbox x:Name="VolumeSpeakerIcon"
                                 Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Data="M3,10 V14 A1,1 0 0 0 4,15 H7 L10.29,18.29 A1,1 0 0 0 12,17.58 V6.41 A1,1 0 0 0 10.29,5.7 L7,9 H4 A1,1 0 0 0 3,10 Z M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V16.02 C15.48,15.29 16.5,13.77 16.5,12 Z M14,5.25 V5.45 A0.92,0.92 0 0 0 14.6,6.3 A6,6 0 0 1 19,12 A6,6 0 0 1 14.6,17.7 A0.92,0.92 0 0 0 14,18.55 V18.75 A0.92,0.92 0 0 0 15.21,19.6 A8,8 0 0 0 21,12 A8,8 0 0 0 15.21,4.4 A0.92,0.92 0 0 0 14,5.25 Z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="VolumePercentText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="{Binding FontSize, ElementName=NowPlayingText}"
                                   FontWeight="SemiBold"
                                   Text="0%"
                                   Visibility="Collapsed" />
                    </Grid>
                    <Image x:Name="AppIconImage"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="Collapsed" />
                </Grid>
            </Button>

            <Button x:Name="CycleSessionButton"
                    Grid.Column="2"
                    MinWidth="0"
                    MinHeight="0"
                    AutomationProperties.Name="Cycle media session"
                    Visibility="Collapsed"
                    Click="CycleSession_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CycleButtonBackground"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding Foreground}"
                                CornerRadius="{DynamicResource PlayerControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CycleButtonBackground" Property="Background" Value="{DynamicResource UtilityHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Viewbox x:Name="CycleSessionIcon" Stretch="Uniform">
                    <Canvas Width="9" Height="14">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M4.5 1.1a.5.5 0 0 1 .38.17l2.85 3.1a.5.5 0 0 1-.38.83h-5.7a.5.5 0 0 1-.38-.83l2.85-3.1a.5.5 0 0 1 .38-.17z" />
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M4.5 12.9a.5.5 0 0 1-.38-.17l-2.85-3.1a.5.5 0 0 1 .38-.83h5.7a.5.5 0 0 1 .38.83l-2.85 3.1a.5.5 0 0 1-.38.17z" />
                    </Canvas>
                </Viewbox>
            </Button>

            <Thumb x:Name="DragHandle"
                    Grid.Column="3"
                    Focusable="True"
                    FocusVisualStyle="{StaticResource KeyboardFocusVisual}"
                    AutomationProperties.Name="Move player"
                    AutomationProperties.HelpText="Use arrow keys to move. Hold Control and press an arrow key to change display."
                    KeyDown="DragHandle_KeyDown"
                    PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="DragHandleBackground"
                                Background="Transparent"
                                CornerRadius="{DynamicResource PlayerControlCornerRadius}">
                            <Viewbox Width="{DynamicResource PlayerDragIconWidth}"
                                     Height="{DynamicResource PlayerDragIconHeight}"
                                     Stretch="Uniform">
                                <Path Fill="{TemplateBinding Foreground}"
                                      Data="M2,0 A2,2 0 1 1 1.999,0 Z M8,0 A2,2 0 1 1 7.999,0 Z M2,6 A2,2 0 1 1 1.999,6 Z M8,6 A2,2 0 1 1 7.999,6 Z M2,12 A2,2 0 1 1 1.999,12 Z M8,12 A2,2 0 1 1 7.999,12 Z" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DragHandleBackground" Property="Background" Value="{DynamicResource UtilityHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
        </Border>

        <Viewbox x:Name="ResizeCue"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 IsHitTestVisible="False"
                 Stretch="Uniform">
            <Canvas Width="9" Height="9">
                <Path Data="M2,7.5 L7.5,2 M5.35,7.85 L7.85,5.35"
                      Stroke="{Binding Foreground, ElementName=DragHandle}"
                      StrokeThickness="1"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Opacity="0.8">
                    <Path.RenderTransform>
                        <TranslateTransform X="-1" />
                    </Path.RenderTransform>
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=PlayerSurface}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Canvas>
        </Viewbox>

        <Thumb x:Name="ResizeHandle"
               HorizontalAlignment="Right"
               Cursor="SizeWE"
               Focusable="True"
               FocusVisualStyle="{StaticResource KeyboardFocusVisual}"
               AutomationProperties.Name="Resize player"
               AutomationProperties.HelpText="Use Left and Right arrow keys to resize."
               DragStarted="ResizeHandle_DragStarted"
               DragDelta="ResizeHandle_DragDelta"
               DragCompleted="ResizeHandle_DragCompleted"
               KeyDown="ResizeHandle_KeyDown">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#01000000" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
